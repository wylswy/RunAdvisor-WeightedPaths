<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">

    <modelVersion>4.0.0</modelVersion>

    <!-- Change These to match your mod -->
    <groupId>com.derekjass.sts</groupId>
    <artifactId>weighted-paths</artifactId>
    <version>1.5.0</version>
    <packaging>jar</packaging>
    <name>Run Advisor</name>
    <description>Map path recommendations, seed previews, and Silent card scoring.</description>

    <!-- 纯逻辑层依赖：无游戏 jar 也能编译/测试，供 CI 门禁永远跑（-Ppure）。
         游戏依赖（desktop-1.0.jar / ModTheSpire / BaseMod）在 game profile 里，默认启用。 -->
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.5</version>
        </dependency>
        <dependency>
            <!-- 游戏运行时内置 log4j（desktop-1.0.jar 提供）：provided 仅供编译/测试，不打包进 mod jar -->
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.17.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 依赖目录：ModTheSpire/BaseMod 随仓（lib/），游戏本体 jar 由 scripts/setup-libs.ps1 获取（gitignored） -->
        <lib.dir>${basedir}/lib</lib.dir>
    </properties>

    <!-- This is how your code is packaged into the jar file-->
    <build>
        <!-- Change this to match your mods name -->
        <finalName>WeightedPaths</finalName>
        <!-- 版本单一事实源：ModTheSpire.json 的 version 由 pom 的 ${project.version} 过滤注入 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>ModTheSpire.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>2.4.2</version>
                <executions>
                    <execution>
                        <!-- Change this to match your mods artifactId -->
                        <id>weighted-paths</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.derekjass.com.google.gson</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <!-- Change this to match your mods groupId:artifactId -->
                                    <artifact>com.derekjass.sts:weighted-paths</artifact>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 完整构建（含游戏层）：默认启用，本地构建/全量测试行为不变。
             需要 lib/desktop-1.0.jar（ModTheSpire/BaseMod 随仓）。 -->
        <profile>
            <id>game</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.megacrit.cardcrawl</groupId>
                    <artifactId>slaythespire</artifactId>
                    <version>017</version>
                    <scope>system</scope>
                    <systemPath>${lib.dir}/desktop-1.0.jar</systemPath>
                </dependency>
                <dependency>
                    <groupId>com.evacipated.cardcrawl</groupId>
                    <artifactId>ModTheSpire</artifactId>
                    <version>3.26.0</version>
                    <scope>system</scope>
                    <systemPath>${lib.dir}/ModTheSpire.jar</systemPath>
                </dependency>
                <dependency>
                    <groupId>basemod</groupId>
                    <artifactId>BaseMod</artifactId>
                    <version>5.39.0</version>
                    <scope>system</scope>
                    <systemPath>${lib.dir}/BaseMod.jar</systemPath>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- 游戏层源码与测试独立目录：src/game/java、src/game-test/java -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>add-game-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${basedir}/src/game/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-game-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${basedir}/src/game-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.2</version>
                        <configuration>
                            <!-- 游戏依赖为 system scope 本地文件，surefire 不将其加入测试 classpath，
                                 这里显式把 jar 文件路径加入测试 classpath，使单测能加载 com.megacrit.cardcrawl.* 类。 -->
                            <additionalClasspathElements>
                                <additionalClasspathElement>${lib.dir}/desktop-1.0.jar</additionalClasspathElement>
                                <additionalClasspathElement>${lib.dir}/ModTheSpire.jar</additionalClasspathElement>
                                <additionalClasspathElement>${lib.dir}/BaseMod.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 纯逻辑构建：mvn -Ppure test 不依赖游戏 jar。
             显式 -P 激活本 profile 会关闭 activeByDefault 的 game profile，
             因此只编译 src/main/java（纯逻辑）与 src/test/java（纯逻辑测试）。 -->
        <profile>
            <id>pure</id>
        </profile>
    </profiles>

</project>